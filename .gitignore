# Todo queda fuera de Git (mundo, .jar, registros, claves y listas de jugadores),
# salvo lo que se nombra abajo con «!».
*
!.gitignore
!CLAUDE.md
!README.md
!.claude/
!.claude/skills/
!.claude/skills/**
!docs/
!docs/**
!scripts/
!scripts/**
!recursos/
!recursos/**
!sitio/
!sitio/**
!plugin/
!plugin/**
# Archivos que los scripts cambian solos al correr
scripts/*.state
scripts/*.flag
# Claves del panel y su registro de errores: solo viven en Hostinger
sitio/admin/api/config.php
sitio/admin/api/registro/
# Lo que compila Maven no va a Git
plugin/target/
sitio/admin/api/archivos/
